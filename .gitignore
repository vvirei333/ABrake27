# Multi-GB firmware artifacts — not versioned
ipsws/
kernelcaches/
extracted/

# Ephemeral / scratch
tmp/
*.log
/tmp/

# OS junk
.DS_Store
Thumbs.db

# iOS toolchain artifacts — never versioned (Apple-proprietary SDK + build output)
poc/SDK/
poc/build/
*.ipa


# Python bytecode (never commit)
__pycache__/
*.pyc

# Sensitive: device pairing private keys / signing cache — never commit
*.mobiledevicepairing
.zsign_cache/

# secrets
*.p12
*.pfx
*.mobileprovision
*.mobiledevicepairing
*.key
*.pem
id_rsa*
.zsign_cache/
**/.zsign_cache/
